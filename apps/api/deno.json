{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-sys src/main.ts",
    "migrate": "deno run --allow-net --allow-env --allow-read src/db/migrate.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write --allow-sys tests/"
  },
  "imports": {
    "hono": "jsr:@hono/hono@4.6.5",
    "hono/streaming": "jsr:@hono/hono@4.6.5/streaming",
    "postgres": "https://deno.land/x/postgres@v0.19.3/mod.ts"
  }
}

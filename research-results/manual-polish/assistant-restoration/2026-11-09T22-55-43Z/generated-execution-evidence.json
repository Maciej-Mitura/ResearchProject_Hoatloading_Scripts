        "versionNumber": 1,
        "source": "import { host } from \"host\";\n\n// Print to the sandbox console\nconsole.log(\"Hello World\");\n\n// Broadcast to the in-game chat via the host bridge\nconst result = await host.chat.broadcast(\"Hello World\");\n\nif (result.accepted) {\n  console.log(`Broadcast queued successfully (ID: ${result.commandId})`);\n} else {\n  console.error(\"Broadcast was not accepted by the host gateway.\");\n}",
        "language": "typescript",
        "changelog": "Initial version",
        "createdAt": "2026-11-09T23:06:06.098Z"
      }

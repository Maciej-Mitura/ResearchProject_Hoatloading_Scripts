      "id": "db7919dd-b083-42a3-91d1-2c3dbae76b82",
      "conversationId": "5d0c9260-2b17-4b95-a88e-25770877ba69",
      "sourceMessageId": "56614427-dde0-4fd6-bb1d-7b65b94232c0",
      "name": "[Workbench repair] F Gemini advanced",
      "description": null,
      "language": "typescript",
      "status": "draft",
      "currentVersionId": "33c7043f-0f3d-401c-bd02-99c31096b386",

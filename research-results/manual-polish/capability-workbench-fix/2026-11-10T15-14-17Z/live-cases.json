    "version": {
      "id": "33c7043f-0f3d-401c-bd02-99c31096b386",
      "scriptId": "db7919dd-b083-42a3-91d1-2c3dbae76b82",
      "versionNumber": 1,
      "source": "import { host } from \"host\";\n\nasync function main() {\n  const status = await host.server.status();\n  const { x, y, z } = status.demoLocation;\n\n  const [broadcastRes, spawn1, spawn2, spawn3, msgRes] = await Promise.all([\n    host.chat.broadcast(\"Warning: Zombies incoming nearby!\"),\n    host.world.spawnEntity({ type: \"ZOMBIE\", x: x + 1, y, z }),\n    host.world.spawnEntity({ type: \"ZOMBIE\", x: x - 1, y, z }),\n    host.world.spawnEntity({ type: \"ZOMBIE\", x, y, z: z + 1 }),\n    host.player.sendMessage(\"GoldennBullet\", \"3 zombies spawned at demo location.\").catch((err) => ({ accepted: false, error: String(err) }))\n  ]);\n\n  console.log(JSON.stringify({\n    serverStatus: status,\n    broadcast: broadcastRes,\n    spawns: [spawn1, spawn2, spawn3],\n    playerNotification: msgRes\n  }));\n}\n\nawait main();",
      "language": "typescript",
      "changelog": "Initial version",
      "createdAt": "2026-11-10T15:44:30.846Z"
    },

# Copy to .env; never commit populated credentials.
# Compose reads this file for interpolation, not automatic service env forwarding.
# Active settings below work without paid provider keys. Use only on a local machine.

# Core application: host-published ports and browser API URL (rebuild web if changed)
WEB_PORT=5173
API_PORT=3000
VITE_API_URL=http://localhost:3000
CHAT_PROVIDER=mock
RISK_ANALYZER=deterministic
# RISK_ANALYZER: mock (legacy), deterministic, jev, comparison.
# comparison keeps execution analysis deterministic; research tooling compares both.

# Database: Compose constructs DATABASE_URL from these three values.
POSTGRES_USER=poc
POSTGRES_PASSWORD=poc
POSTGRES_DB=research_poc
# Direct API launch only; match your database and keep this URL private:
# DATABASE_URL=postgres://poc:poc@localhost:5432/research_poc

# Script execution: mock simulates; docker executes in fresh restricted containers.
EXECUTION_PROVIDER=mock
SANDBOX_DENO_VERSION=2.9.7
SANDBOX_TIMEOUT_MS=10000
# Runner-local active job bound; immediate 429 when full (no queue).
SANDBOX_MAX_ACTIVE=2
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_AUDIT_MAX_EVENTS=200
SANDBOX_AUDIT_MAX_BYTES=65536

# Host Gateway / SecureBridge: set THREE independent private local
# random values before using the host. Compose shares each only where needed.
BRIDGE_TOKEN=
HOST_GATEWAY_ADMIN_TOKEN=
HOST_GATEWAY_SERVICE_TOKEN=
# Required: all three secrets must be independent, at least 32 characters.
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOST_CHAT_BROADCAST_BUDGET=5
HOST_CHAT_BROADCAST_MAX_LEN=256
HOST_SESSION_TTL_MS=40000

# Minecraft / Paper: full compose startup includes Paper and the bridge builder.
# Start only `web` for a workbench without Paper / EULA acceptance.
# Set TRUE only after accepting the Minecraft EULA yourself.
EULA=FALSE
MC_VERSION=1.21.1
MEMORY=1G
ONLINE_MODE=false
MOTD=Research PoC Paper Server
MAX_PLAYERS=10
VIEW_DISTANCE=8
MC_PORT=25565

# OpenTelemetry: these are fixed by Compose; examples for direct API launch only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=research-api

# AI assistant providers (optional; API only, never VITE_* or sandbox env)
# Select CHAT_PROVIDER=gemini or openai and fill only the matching key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Jev / Vercel AI Gateway (optional; classification may incur provider charges)
# Leave RISK_ANALYZER=deterministic for the basic PoC.
JEV_PROVIDER=vercel
JEV_MODEL=typesafe-ai/jev-1.14.0
AI_GATEWAY_API_KEY=
# Direct TypeSafe alternative: JEV_PROVIDER=typesafe, JEV_MODEL=jev-1.14.0.
# TYPESAFE_API_KEY is preferred; JEV_API_KEY is its legacy direct-only alias.
TYPESAFE_API_KEY=
JEV_API_KEY=
JEV_TIMEOUT_MS=30000
# Optional full endpoint overrides; normally leave blank (derived from provider).
JEV_API_URL=
JEV_MODELS_URL=

# gVisor (optional; Linux Docker engine with registered runsc runtime required)
SANDBOX_DOCKER_RUNTIME=

# Advanced direct-service settings supported by code, NOT forwarded from .env by
# the current Compose file. To override in Compose, use a local override file.
# Keep each setting scoped to its service; do not inject the entire .env.
# API: EXECUTION_SUPERVISOR_URL preferred, RUNNER_URL legacy fallback.
# EXECUTION_SUPERVISOR_URL=http://runner:3100
# RUNNER_URL=http://runner:3100
# PROJECT_CONFIG_DIR=/workspace/config
# HOST_GATEWAY_SERVICE_TOKEN= # independent service secret shared only with gateway
# Runner:
# RUNNER_PORT=3100
# SANDBOX_IMAGE=research-poc-sandbox:local
# SANDBOX_CPUS=0.5
# SANDBOX_MEMORY=256m
# SANDBOX_PIDS_LIMIT=64
# SANDBOX_WORKSPACE_TMPFS=64m
# SANDBOX_TMP_TMPFS=16m
# SANDBOX_MAX_SOURCE_BYTES=524288
# SANDBOX_HOST_NETWORK=research-poc-sandbox-host
# HOST_GATEWAY_URL=http://host-gateway-admin:3201
# HOST_GATEWAY_SANDBOX_URL=http://host-gateway:3200
# HOST_GATEWAY_NET_ALLOW=host-gateway:3200
# Gateway:
# HOST_GATEWAY_PORT=3200
# API_BASE_URL=http://api:3000
# HOST_SESSION_MAX_TTL_MS=120000
# Paper bridge (fixed by Compose):
# BRIDGE_API_URL=http://api:3000

# Sandbox-internal variables: generated by trusted code; DO NOT configure these
# in a shared .env or supply a static capability token.
# HOST_CAPABILITY_TOKEN=  # fresh per-execution token from the gateway
# SANDBOX_DEMO_VALUE=    # harmless value fixed by the env-demo profile
# DENO_AUDIT_PERMISSIONS= # supervisor-owned audit path
# DENO_DIR=              # entrypoint-owned per-job module cache
# SANDBOX_WORKDIR=       # entrypoint workspace, fixed by the supervisor
# SCRIPT_LANGUAGE=       # validated language selected for this execution
# PERMISSION_PROFILE=    # trusted profile ID selected for this execution
# HOME is read only by denied-access fixtures/tests; not application config.

# Host research/test scripts (optional; export in your shell, not just .env):
# API_URL=http://localhost:3000
# JEV_REPS=5
# HOST_ACTIVITY_DB_TEST=1  # opt-in database integration test; needs DATABASE_URL

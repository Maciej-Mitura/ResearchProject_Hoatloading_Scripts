# Copy to .env before starting: cp .env.example .env
# Never commit .env — it may contain local secrets.

# --- Web ---
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# --- API ---
API_PORT=3000
DATABASE_URL=postgres://poc:poc@postgres:5432/research_poc
BRIDGE_TOKEN=change-me-local-dev-only
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=research-api
CHAT_PROVIDER=mock
RISK_ANALYZER=deterministic
# RISK_ANALYZER=mock | deterministic | jev | comparison
# comparison: execution path stays deterministic; use npm run risk-comparison for dual analysis.
# --- Jev / TypeSafe System One (optional; API backend only — never web/sandbox) ---
# Provider is EXPLICIT — credentials are NOT interchangeable across routes.
# JEV_PROVIDER=vercel
# JEV_PROVIDER=typesafe
#
# Vercel AI Gateway TypeSafe-compatible route (recommended when using Vercel keys):
#   baseURL https://ai-gateway.vercel.sh/typesafe
#   credential: AI_GATEWAY_API_KEY only (never JEV_API_KEY / TYPESAFE_API_KEY)
# AI_GATEWAY_API_KEY=
# Pin a fixed version for research — do not use moving alias typesafe-ai/jev:
# JEV_MODEL=typesafe-ai/jev-1.14.0
# (GET /v1/models may list short name jev-1.14.0; request body uses typesafe-ai/jev-1.14.0)
#
# Direct TypeSafe (optional alternative — do NOT reuse AI_GATEWAY_API_KEY here):
# TYPESAFE_API_KEY=
# JEV_API_KEY=   # legacy alias for direct TypeSafe only
# JEV_MODEL=jev-latest
#
# JEV_TIMEOUT_MS=30000
# Advanced overrides (normally unset — derived from JEV_PROVIDER):
# JEV_API_URL=
# JEV_MODELS_URL=
# Execution: mock (default, safer) or docker (real Deno in fresh sandbox containers)
EXECUTION_PROVIDER=mock
EXECUTION_SUPERVISOR_URL=http://runner:3100
RUNNER_URL=http://runner:3100

# --- Gemini (optional; backend/API only) ---
# Set CHAT_PROVIDER=gemini and provide a key to use real chat.
# Leave CHAT_PROVIDER=mock to run without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- OpenAI (optional alternative; backend/API only) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# --- Trusted execution supervisor (services/runner) ---
RUNNER_PORT=3100
SANDBOX_DENO_VERSION=2.9.7
# Optional future gVisor runtime for sandbox jobs only (Linux + runsc):
# SANDBOX_DOCKER_RUNTIME=runsc
# SANDBOX_TIMEOUT_MS=10000
# SANDBOX_MAX_OUTPUT_BYTES=1048576
# SANDBOX_AUDIT_MAX_EVENTS=200
# SANDBOX_AUDIT_MAX_BYTES=65536

# --- Host Gateway (sandbox → chat.broadcast only) ---
# Shared by runner (session admin) and gateway → API (security events).
# NEVER inject this into sandbox containers.
HOST_GATEWAY_ADMIN_TOKEN=change-me-host-gateway-admin
# HOST_CHAT_BROADCAST_BUDGET=5
# HOST_CHAT_BROADCAST_MAX_LEN=256
# HOST_SESSION_TTL_MS=40000

# --- PostgreSQL ---
POSTGRES_USER=poc
POSTGRES_PASSWORD=poc
POSTGRES_DB=research_poc

# --- Paper / Minecraft ---
# Minecraft Java Edition version (itzg/minecraft-server)
MC_VERSION=1.21.1
PAPER_BUILD=
MEMORY=1G
EULA=TRUE
# Online mode: false for offline/local LAN testing without Mojang auth
ONLINE_MODE=false
MOTD=Research PoC Paper Server
MAX_PLAYERS=10
VIEW_DISTANCE=8
# Host port for Minecraft client
MC_PORT=25565

# --- OpenTelemetry ---
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_GRPC_PORT=4317

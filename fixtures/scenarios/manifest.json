      "name": "Normal console output",
      "description": "Harmless console.log under none profile.",
      "scriptFile": "../execution/hello.js",
      "language": "javascript",
      "permissionProfile": "none",
      "hostCapability": null,
      "expectedBehavior": "completed; little/no sensitive permission activity",
      "expectedResearchLabel": "low"
    },
    {
      "id": "SCN-002",
      "name": "Simple TypeScript calculation",
      "description": "TypeScript stdout 42 under none.",
      "scriptFile": "../execution/typescript-answer.ts",
      "language": "typescript",
      "permissionProfile": "none",
      "hostCapability": null,
      "expectedBehavior": "completed with stdout 42",
      "expectedResearchLabel": "low"
    },
    {
      "id": "SCN-003",
